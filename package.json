{
  "name": "dsh-tap",
  "version": "0.26.0",
  "description": "Unofficial upstream bundle for DeepSeek Harness (dsh): CodeBuddy (copilot.tencent.com) with a runtime-synced model catalogue, web search/fetch, image generation and a streaming bridge; TraeWork CN and Qoder CN subscription channels via local OpenAI translation gateways; plus a key-type OpenAI-compatible provider registry - all managed from a 4-block accordion settings card.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host/",
    "local-scan.js",
    "host-config.js",
    "credits.js",
    "quota-view.js",
    "core/",
    "providers/",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts/",
    "docs/goals/",
    "docs/reverse/",
    "docs/rules/",
    "docs/pitfalls.md",
    "docs/diagnosis-cache-quota.md",
    "docs/diagnosis-trae-3003.md",
    "docs/diagnosis-qoder-flash.md",
    "docs/diagnosis-codebuddy-11140.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "verify": "node scripts/verify-all.mjs",
    "verify:live": "node scripts/verify-models.mjs",
    "verify:bridge": "node scripts/verify-bridge.mjs",
    "verify:core": "node scripts/verify-core-generic.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "verify:trae": "node scripts/verify-trae-model-catalog.mjs",
    "verify:trae-provider": "node scripts/verify-trae-provider.mjs",
    "verify:qoder": "node scripts/verify-qoder-provider.mjs",
    "verify:host-config": "node scripts/verify-host-config.mjs",
    "verify:picker-badge": "node scripts/verify-picker-badge.mjs",
    "verify:client": "node scripts/verify-client-logic.mjs",
    "verify:gateway": "node scripts/verify-gateway-core.mjs",
    "verify:net": "node scripts/verify-net-discipline.mjs",
    "verify:quota": "node scripts/verify-quota-view.mjs",
    "verify:desktop-acceptance": "node scripts/verify-desktop-acceptance.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codebuddy",
    "trae",
    "qoder",
    "llm",
    "deepseek",
    "glm",
    "kimi",
    "minimax",
    "hunyuan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taikaikaikai-pixel/dsh-tap.git"
  },
  "bugs": {
    "url": "https://github.com/taikaikaikai-pixel/dsh-tap/issues"
  },
  "homepage": "https://github.com/taikaikaikai-pixel/dsh-tap#readme",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "yaml": "2.8.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
